        <!-- Строка 2 -->
        <mxCell id="37" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;top=0;left=0;bottom=0;right=0;collapsible=0;childLayout=stackLayout;fillColor=none;" parent="30" vertex="1">
          <mxGeometry y="100" width="200" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="38" value="i=2: [-  -  ×  ×]" style="shape=partialRectangle;top=0;left=0;bottom=0;right=0;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#666666;" parent="37" vertex="1">
          <mxGeometry width="200" height="35" as="geometry"/>
