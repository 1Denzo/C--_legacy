<mxfile host="app.diagrams.net">
  <diagram name="Average Top Triangle" id="avg-top-triangle">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        
        <!-- НАЧАЛО -->
        <mxCell id="2" value="НАЧАЛО" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="320" y="40" width="120" height="50" as="geometry"/>
        </mxCell>
        
        <!-- Вычисление количества элементов -->
        <mxCell id="3" value="count = (1 + N) / 2 * N" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1">
          <mxGeometry x="320" y="120" width="150" height="60" as="geometry"/>
        </mxCell>
        
        <!-- Стрелка: НАЧАЛО → Вычисление count -->
        <mxCell id="4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" parent="1" source="2" target="3" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Вызов функции sumTopTriangle -->
        <mxCell id="5" value="sum = sumTopTriangle(m)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
          <mxGeometry x="320" y="220" width="150" height="60" as="geometry"/>
        </mxCell>
        
        <!-- Стрелка: Вычисление count → Вызов sum -->
        <mxCell id="6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" parent="1" source="3" target="5" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Подпроцесс: sumTopTriangle -->
        <mxCell id="7" value="ПОДПРОЦЕСС:&#xa;sumTopTriangle(m)" style="swimlane;whiteSpace=wrap;html=1;startSize=20;horizontal=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
          <mxGeometry x="500" y="200" width="200" height="260" as="geometry"/>
        </mxCell>
        
        <!-- Инициализация суммы в подпроцессе -->
        <mxCell id="8" value="sum_local = 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="7" vertex="1">
          <mxGeometry x="10" y="40" width="180" height="40" as="geometry"/>
        </mxCell>
        
        <!-- Цикл i в подпроцессе -->
        <mxCell id="9" value="for i = 0 to N-1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="7" vertex="1">
          <mxGeometry x="10" y="100" width="180" height="60" as="geometry"/>
        </mxCell>
        
        <!-- Стрелка: инициализация → цикл i -->
        <mxCell id="10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" parent="7" source="8" target="9" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Цикл j в подпроцессе (для верхнетреугольной части) -->
        <mxCell id="11" value="for j = i to N-1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="7" vertex="1">
          <mxGeometry x="10" y="180" width="180" height="60" as="geometry"/>
        </mxCell>
        
        <!-- Стрелка: цикл i (ДА) → цикл j -->
        <mxCell id="12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" parent="7" source="9" target="11" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Суммирование в подпроцессе -->
        <mxCell id="13" value="sum_local += m[i][j]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="7" vertex="1">
          <mxGeometry x="10" y="260" width="180" height="40" as="geometry"/>
        </mxCell>
        
        <!-- Стрелка: цикл j (ДА) → суммирование -->
        <mxCell id="14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" parent="7" source="11" target="13" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Возврат к циклу j -->
        <mxCell id="15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" parent="7" source="13" target="11" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="16" value="j++" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" parent="15" vertex="1" connectable="0">
          <mxGeometry x="-0.3" y="1" relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Возврат к циклу i -->
        <mxCell id="17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" parent="7" source="11" target="9" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="100" y="320"/>
              <mxPoint x="100" y="140"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="18" value="j == N&#xa;i++" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" parent="17" vertex="1" connectable="0">
          <mxGeometry x="-0.1" y="-1" relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Возврат из подпроцесса -->
        <mxCell id="19" value="return sum_local" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="7" vertex="1">
          <mxGeometry x="10" y="320" width="180" height="40" as="geometry"/>
        </mxCell>
        
        <!-- Стрелка: цикл i (НЕТ) → возврат -->
        <mxCell id="20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" parent="7" source="9" target="19" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="100" y="360"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="21" value="i == N" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" parent="20" vertex="1" connectable="0">
          <mxGeometry x="0.5" y="-1" relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Вычисление среднего арифметического -->
        <mxCell id="22" value="avg = sum / count" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
          <mxGeometry x="320" y="320" width="150" height="60" as="geometry"/>
        </mxCell>
        
        <!-- Стрелка: Вызов sum → Вычисление avg -->
        <mxCell id="23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" parent="1" source="5" target="22" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Возврат результата -->
        <mxCell id="24" value="ВЕРНУТЬ avg" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="320" y="420" width="150" height="60" as="geometry"/>
        </mxCell>
        
        <!-- Стрелка: Вычисление avg → Возврат -->
        <mxCell id="25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" parent="1" source="22" target="24" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- КОНЕЦ -->
        <mxCell id="26" value="КОНЕЦ" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="335" y="520" width="120" height="50" as="geometry"/>
        </mxCell>
        
        <!-- Стрелка: Возврат → КОНЕЦ -->
        <mxCell id="27" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" parent="1" source="24" target="26" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Легенда -->
        <mxCell id="28" value="Условные обозначения:&#xa;● Овал – начало/конец&#xa;● Прямоугольник с закруглениями – действие&#xa;● Ромб – условие/цикл&#xa;● Плашка с заголовком – подпроцесс" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="20" y="40" width="250" height="90" as="geometry"/>
        </mxCell>
        
        <!-- Формула количества элементов -->
        <mxCell id="29" value="Количество элементов в верхнетреугольной части:&#xa;count = (1 + N) / 2 * N = N(N+1)/2" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="320" y="600" width="300" height="50" as="geometry"/>
        </mxCell>
        
        <!-- Визуализация верхнетреугольной матрицы -->
        <mxCell id="30" value="" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fillColor=#f5f5f5;strokeColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="320" y="670" width="200" height="140" as="geometry"/>
        </mxCell>
        
        <!-- Заголовок -->
        <mxCell id="31" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;top=0;left=0;bottom=0;right=0;collapsible=0;childLayout=stackLayout;fillColor=none;" parent="30" vertex="1">
          <mxGeometry width="200" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="32" value="    j→   0    1    2    3" style="shape=partialRectangle;top=0;left=0;bottom=0;right=0;align=center;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#666666;" parent="31" vertex="1">
          <mxGeometry width="200" height="30" as="geometry"/>
        </mxCell>
        
        <!-- Строка 0 -->
        <mxCell id="33" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;top=0;left=0;bottom=0;right=0;collapsible=0;childLayout=stackLayout;fillColor=none;" parent="30" vertex="1">
          <mxGeometry y="30" width="200" height="35" as="geometry"/>
