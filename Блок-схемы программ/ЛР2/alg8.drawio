        <mxCell id="36" value="i=1: [-  ×  ×  ×]" style="shape=partialRectangle;top=0;left=0;bottom=0;right=0;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#666666;" parent="35" vertex="1">
          <mxGeometry width="200" height="35" as="geometry"/>
