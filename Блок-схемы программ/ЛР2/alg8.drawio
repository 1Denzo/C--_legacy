        <!-- Строка 3 -->
        <mxCell id="39" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;top=0;left=0;bottom=0;right=0;collapsible=0;childLayout=stackLayout;fillColor=none;" parent="30" vertex="1">
          <mxGeometry y="135" width="200" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="40" value="i=3: [-  -  -  ×]" style="shape=partialRectangle;top=0;left=0;bottom=0;right=0;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#666666;" parent="39" vertex="1">
          <mxGeometry width="200" height="35" as="geometry"/>
        </mxCell>
        
        <!-- Пояснение -->
        <mxCell id="41" value="× - элементы верхнетреугольной части" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="320" y="820" width="200" height="30" as="geometry"/>
        </mxCell>
        
        <!-- Информация о сложности -->
        <mxCell id="42" value="Сложность: O(N²)&#xa;(определяется функцией sumTopTriangle)" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=#e1d5e7;" parent="1" vertex="1">
          <mxGeometry x="550" y="520" width="200" height="40" as="geometry"/>
        </mxCell>
        
        <!-- Примечание о симметрии -->
        <mxCell id="43" value="Примечание: количество элементов в верхнетреугольной части&#xa;совпадает с нижнетреугольной = N(N+1)/2" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=#fff2cc;" parent="1" vertex="1">
