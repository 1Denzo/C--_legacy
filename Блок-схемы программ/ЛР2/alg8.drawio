        <!-- Строка 1 -->
        <mxCell id="35" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;top=0;left=0;bottom=0;right=0;collapsible=0;childLayout=stackLayout;fillColor=none;" parent="30" vertex="1">
          <mxGeometry y="65" width="200" height="35" as="geometry"/>
