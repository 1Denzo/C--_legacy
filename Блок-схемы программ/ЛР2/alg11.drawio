<mxfile host="app.diagrams.net">
  <diagram name="MinMax Rows">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        
        <!-- НАЧАЛО -->
        <mxCell id="2" value="НАЧАЛО" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" parent="1" vertex="1">
          <mxGeometry x="340" y="40" width="100" height="50" as="geometry"/>
        </mxCell>
        
        <!-- Выделение памяти -->
        <mxCell id="3" value="minRows = new float[N]&#xa;maxRows = new float[N]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;" parent="1" vertex="1">
          <mxGeometry x="330" y="120" width="120" height="70" as="geometry"/>
        </mxCell>
        
        <!-- Связь -->
        <mxCell id="4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0.5;entryY=0;exitX=0.5;exitY=1;" parent="1" source="2" target="3" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Цикл i -->
        <mxCell id="5" value="i = 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;" parent="1" vertex="1">
          <mxGeometry x="340" y="220" width="100" height="50" as="geometry"/>
        </mxCell>
        
        <!-- Связь -->
        <mxCell id="6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0.5;entryY=0;exitX=0.5;exitY=1;" parent="1" source="3" target="5" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Условие i < N -->
        <mxCell id="7" value="i &lt; N ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;" parent="1" vertex="1">
          <mxGeometry x="340" y="300" width="100" height="80" as="geometry"/>
        </mxCell>
        
        <!-- Связь -->
        <mxCell id="8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0.5;entryY=0;exitX=0.5;exitY=1;" parent="1" source="5" target="7" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Инициализация min/max -->
        <mxCell id="9" value="min = +∞&#xa;max = -∞" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;" parent="1" vertex="1">
          <mxGeometry x="500" y="320" width="100" height="60" as="geometry"/>
        </mxCell>
        
        <!-- Связь ДА -->
        <mxCell id="10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0.5;entryY=0;exitX=1;exitY=0.5;" parent="1" source="7" target="9" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="470" y="340"/>
            </Array>
          </mxGeometry>
        </mxCell>
        
        <!-- j = 0 -->
        <mxCell id="11" value="j = 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;" parent="1" vertex="1">
          <mxGeometry x="500" y="410" width="100" height="50" as="geometry"/>
        </mxCell>
        
        <!-- Связь -->
        <mxCell id="12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0.5;entryY=0;exitX=0.5;exitY=1;" parent="1" source="9" target="11" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Условие j < N -->
        <mxCell id="13" value="j &lt; N ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;" parent="1" vertex="1">
          <mxGeometry x="500" y="490" width="100" height="80" as="geometry"/>
        </mxCell>
        
        <!-- Связь -->
        <mxCell id="14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0.5;entryY=0;exitX=0.5;exitY=1;" parent="1" source="11" target="13" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Обновление min -->
        <mxCell id="15" value="if (m[i][j] &lt; min)&#xa;    min = m[i][j]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;" parent="1" vertex="1">
          <mxGeometry x="670" y="520" width="120" height="60" as="geometry"/>
        </mxCell>
        
        <!-- Связь ДА -->
        <mxCell id="16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0.5;entryY=0;exitX=1;exitY=0.5;" parent="1" source="13" target="15" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="630" y="530"/>
            </Array>
          </mxGeometry>
        </mxCell>
        
        <!-- Обновление max -->
        <mxCell id="17" value="if (m[i][j] &gt; max)&#xa;    max = m[i][j]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;" parent="1" vertex="1">
          <mxGeometry x="670" y="600" width="120" height="60" as="geometry"/>
        </mxCell>
        
        <!-- Связь -->
        <mxCell id="18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0.5;entryY=0;exitX=0.5;exitY=1;" parent="1" source="15" target="17" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- j++ -->
        <mxCell id="19" value="j++" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;" parent="1" vertex="1">
          <mxGeometry x="500" y="690" width="100" height="50" as="geometry"/>
        </mxCell>
        
        <!-- Связь от max к j++ -->
        <mxCell id="20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0.5;entryY=0;exitX=0.5;exitY=1;" parent="1" source="17" target="19" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="730" y="690"/>
              <mxPoint x="550" y="690"/>
            </Array>
          </mxGeometry>
        </mxCell>
        
        <!-- Связь от j++ к условию j -->
        <mxCell id="21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0.5;entryY=0;exitX=0.5;exitY=1;" parent="1" source="19" target="13" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Сохранение результатов -->
        <mxCell id="22" value="minRows[i] = min&#xa;maxRows[i] = max" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;" parent="1" vertex="1">
          <mxGeometry x="340" y="600" width="120" height="60" as="geometry"/>
        </mxCell>
        
        <!-- Связь НЕТ от условия j -->
        <mxCell id="23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0.5;entryY=0;exitX=0;exitY=0.5;" parent="1" source="13" target="22" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="470" y="570"/>
              <mxPoint x="400" y="570"/>
            </Array>
          </mxGeometry>
        </mxCell>
        
        <!-- i++ -->
        <mxCell id="24" value="i++" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;" parent="1" vertex="1">
          <mxGeometry x="340" y="690" width="100" height="50" as="geometry"/>
        </mxCell>
        
        <!-- Связь -->
        <mxCell id="25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0.5;entryY=0;exitX=0.5;exitY=1;" parent="1" source="22" target="24" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Связь к условию i -->
        <mxCell id="26" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0.5;entryY=0;exitX=0.5;exitY=1;" parent="1" source="24" target="7" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Возврат результата -->
        <mxCell id="27" value="return {minRows, maxRows}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" parent="1" vertex="1">
          <mxGeometry x="340" y="420" width="130" height="50" as="geometry"/>
        </mxCell>
        
        <!-- Связь НЕТ от условия i -->
        <mxCell id="28" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0.5;entryY=0;exitX=0;exitY=0.5;" parent="1" source="7" target="27" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="310" y="380"/>
              <mxPoint x="310" y="445"/>
            </Array>
          </mxGeometry>
        </mxCell>
        
        <!-- КОНЕЦ -->
        <mxCell id="29" value="КОНЕЦ" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" parent="1" vertex="1">
          <mxGeometry x="340" y="500" width="100" height="50" as="geometry"/>
        </mxCell>
        
        <!-- Связь -->
        <mxCell id="30" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;entryX=0.5;entryY=0;exitX=0.5;exitY=1;" parent="1" source="27" target="29" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Пояснения -->
        <mxCell id="31" value="+∞ = numeric_limits&lt;float&gt;::infinity()&#xa;-∞ = -numeric_limits&lt;float&gt;::infinity()" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;" parent="1" vertex="1">
          <mxGeometry x="20" y="40" width="250" height="40" as="geometry"/>
        </mxCell>
        
        <mxCell id="32" value="Сложность: O(N²)&#xa;Память: O(N)" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;fillColor=#e1d5e7;" parent="1" vertex="1">
          <mxGeometry x="20" y="100" width="120" height="40" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>