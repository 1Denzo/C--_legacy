<mxfile host="Electron" agent="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/29.5.2 Chrome/142.0.7444.265 Electron/39.6.1 Safari/537.36" version="29.5.2">
  <diagram name="Подсчет символов в файле" id="file-counter">
    <mxGraphModel dx="1449" dy="859" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="legend" parent="1" style="text;html=1;strokeColor=#666666;fillColor=#f9f9f9;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10" value="УСЛОВНЫЕ ОБОЗНАЧЕНИЯ:&#xa;🔵 Овал - Начало/Конец&#xa;🟡 Параллелограмм - Ввод/Вывод&#xa;🟢 Прямоугольник - Операции&#xa;🟠 Ромб - Условия&#xa;🔴 Красный - Ошибка&#xa;⚪ Голубой - Цикл" vertex="1">
          <mxGeometry height="150" width="200" x="20" y="20" as="geometry" />
        </mxCell>
        <mxCell id="start" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=16;fontStyle=1" value="НАЧАЛО" vertex="1">
          <mxGeometry height="50" width="120" x="540" y="20" as="geometry" />
        </mxCell>
        <mxCell id="declare" parent="1" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;fontSize=11" value="Объявление переменных:&#xa;c, n[50], buf, empty=0, notempty=0, *f" vertex="1">
          <mxGeometry height="60" width="160" x="530" y="90" as="geometry" />
        </mxCell>
        <mxCell id="prompt" parent="1" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11" value="Вывод: &#39;Введите имя файла:&#39;" vertex="1">
          <mxGeometry height="40" width="140" x="540" y="170" as="geometry" />
        </mxCell>
        <mxCell id="input" parent="1" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11" value="scanf(&#39;%s&#39;, n)" vertex="1">
          <mxGeometry height="40" width="140" x="540" y="230" as="geometry" />
        </mxCell>
        <mxCell id="open" parent="1" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;fontSize=11" value="f = fopen(n, &#39;r&#39;)" vertex="1">
          <mxGeometry height="40" width="140" x="540" y="290" as="geometry" />
        </mxCell>
        <mxCell id="check" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11" value="f == NULL ?" vertex="1">
          <mxGeometry height="60" width="140" x="540" y="350" as="geometry" />
        </mxCell>
        <mxCell id="error" parent="1" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11" value="Вывод: &#39;Файл не открыт&#39;" vertex="1">
          <mxGeometry height="40" width="140" x="220" y="360" as="geometry" />
        </mxCell>
        <mxCell id="while_start" parent="1" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;fontSize=12;fontStyle=1" value="while (!feof(f))" vertex="1">
          <mxGeometry height="40" width="160" x="720" y="350" as="geometry" />
        </mxCell>
        <mxCell id="read" parent="1" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;fontSize=11" value="buf = getc(f)" vertex="1">
          <mxGeometry height="40" width="140" x="940" y="350" as="geometry" />
        </mxCell>
        <mxCell id="check_eof" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11" value="!feof(f) ?" vertex="1">
          <mxGeometry height="50" width="120" x="950" y="420" as="geometry" />
        </mxCell>
        <mxCell id="print" parent="1" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11" value="putchar(buf)" vertex="1">
          <mxGeometry height="40" width="120" x="950" y="500" as="geometry" />
        </mxCell>
        <mxCell id="check_type" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11" value="isspace(buf) или iscntrl(buf) ?" vertex="1">
          <mxGeometry height="60" width="120" x="740" y="530" as="geometry" />
        </mxCell>
        <mxCell id="empty_inc" parent="1" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;fontSize=11" value="empty++" vertex="1">
          <mxGeometry height="40" width="100" x="630" y="620" as="geometry" />
        </mxCell>
        <mxCell id="notempty_inc" parent="1" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;fontSize=11" value="notempty++" vertex="1">
          <mxGeometry height="40" width="100" x="870" y="650" as="geometry" />
        </mxCell>
        <mxCell id="loop_back" parent="1" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;fontSize=11" value="возврат в while" vertex="1">
          <mxGeometry height="40" width="120" x="530" y="460" as="geometry" />
        </mxCell>
        <mxCell id="close" parent="1" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;rounded=1;fontSize=11" value="fclose(f)" vertex="1">
          <mxGeometry height="40" width="140" x="420" y="540" as="geometry" />
        </mxCell>
        <mxCell id="results" parent="1" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11" value="Вывод статистики:&#xa;empty, notempty, total" vertex="1">
          <mxGeometry height="60" width="140" x="420" y="685" as="geometry" />
        </mxCell>
        <mxCell id="end" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=16;fontStyle=1" value="КОНЕЦ" vertex="1">
          <mxGeometry height="50" width="120" x="230" y="690" as="geometry" />
