          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- power: конец -->
        <mxCell id="32" value="КОНЕЦ power" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="17">
