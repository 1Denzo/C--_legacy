        <!-- Вывод результата -->
        <mxCell id="34" value="cout &lt;&lt; &quot;Число &quot; &lt;&lt; num &lt;&lt; &quot; в степени &quot; &lt;&lt; pw &lt;&lt; &quot; = &quot; &lt;&lt; k &lt;&lt; endl;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="1">
