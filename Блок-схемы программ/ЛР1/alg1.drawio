<mxfile host="app.diagrams.net">
  <diagram name="Возведение в степень">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        
        <!-- НАЧАЛО main -->
        <mxCell id="2" value="НАЧАЛО main()" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="340" y="20" width="120" height="50" as="geometry"/>
        </mxCell>
        
        <!-- Объявление переменных -->
        <mxCell id="3" value="string numInput, pwInput;&#xa;int num, pw;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="330" y="90" width="140" height="60" as="geometry"/>
        </mxCell>
        
        <!-- Связь -->
        <mxCell id="4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="2" target="3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Запрос числа -->
        <mxCell id="5" value="cout &lt;&lt; &quot;Введите число: &quot;;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;" vertex="1" parent="1">
          <mxGeometry x="330" y="170" width="140" height="40" as="geometry"/>
        </mxCell>
        
