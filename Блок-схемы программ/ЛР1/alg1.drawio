          <mxGeometry relative="1" as="geometry">
            <mxPoint x="150" y="180" as="sourcePoint"/>
          </mxGeometry>
        </mxCell>
        
        <!-- power: i++ -->
        <mxCell id="27" value="i++" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="17">
          <mxGeometry x="190" y="190" width="80" height="30" as="geometry"/>
        </mxCell>
        
        <!-- Связь -->
        <mxCell id="28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="17" source="25" target="27">
