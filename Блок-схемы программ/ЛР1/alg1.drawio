          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Ввод числа -->
        <mxCell id="7" value="cin &gt;&gt; numInput;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="330" y="230" width="140" height="40" as="geometry"/>
        </mxCell>
        
        <!-- Связь -->
        <mxCell id="8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="5" target="7">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Запрос степени -->
        <mxCell id="9" value="cout &lt;&lt; &quot;Введите степень: &quot;;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;" vertex="1" parent="1">
          <mxGeometry x="330" y="290" width="140" height="40" as="geometry"/>
        </mxCell>
        
        <!-- Связь -->
        <mxCell id="10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="7" target="9">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Ввод степени -->
        <mxCell id="11" value="cin &gt;&gt; pwInput;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="330" y="350" width="140" height="40" as="geometry"/>
        </mxCell>
        
        <!-- Связь -->
        <mxCell id="12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="9" target="11">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Конвертация строк в числа -->
        <mxCell id="13" value="num = stoi(numInput);&#xa;pw = stoi(pwInput);" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="330" y="410" width="140" height="60" as="geometry"/>
        </mxCell>
        
        <!-- Связь -->
        <mxCell id="14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="11" target="13">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Вызов функции power -->
        <mxCell id="15" value="k = power(num, pw);" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="340" y="490" width="120" height="40" as="geometry"/>
        </mxCell>
        
        <!-- Связь -->
        <mxCell id="16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="13" target="15">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- Подпрограмма power -->
        <mxCell id="17" value="ПОДПРОГРАММА power(int n, int x)" style="swimlane;whiteSpace=wrap;html=1;startSize=20;horizontal=1;fillColor=#e1d5e7;" vertex="1" parent="1">
          <mxGeometry x="500" y="350" width="200" height="230" as="geometry"/>
        </mxCell>
        
        <!-- power: начало -->
        <mxCell id="18" value="НАЧАЛО power" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="17">
          <mxGeometry x="40" y="20" width="120" height="40" as="geometry"/>
        </mxCell>
        
        <!-- power: p = 1 -->
        <mxCell id="19" value="int p = 1;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;" vertex="1" parent="17">
          <mxGeometry x="50" y="70" width="100" height="30" as="geometry"/>
        </mxCell>
        
        <!-- Связь -->
        <mxCell id="20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="17" source="18" target="19">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- power: i = 1 -->
        <mxCell id="21" value="i = 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="17">
          <mxGeometry x="50" y="110" width="100" height="30" as="geometry"/>
        </mxCell>
        
        <!-- Связь -->
        <mxCell id="22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="17" source="19" target="21">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- power: условие i < x -->
        <mxCell id="23" value="i &lt; x ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="17">
          <mxGeometry x="50" y="150" width="100" height="60" as="geometry"/>
        </mxCell>
        
        <!-- Связь -->
        <mxCell id="24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="17" source="21" target="23">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- power: p *= n -->
        <mxCell id="25" value="p *= n;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="17">
          <mxGeometry x="190" y="150" width="80" height="30" as="geometry"/>
        </mxCell>
        
        <!-- Связь ДА -->
