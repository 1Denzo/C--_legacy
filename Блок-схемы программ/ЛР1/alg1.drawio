          <mxGeometry relative="1" as="geometry">
            <mxPoint x="230" y="220" as="sourcePoint"/>
            <mxPoint x="100" y="200" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        
        <!-- power: return p -->
        <mxCell id="30" value="return p;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="17">
